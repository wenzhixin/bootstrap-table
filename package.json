{
  "name": "bootstrap-table",
  "version": "1.28.0",
  "description": "An extended table to integration with some of the most widely used CSS frameworks. (Supports Bootstrap, Semantic UI, Bulma, Material Design, Foundation)",
  "keywords": [
    "bootstrap",
    "table",
    "pagination",
    "checkbox",
    "radio",
    "datatables",
    "css",
    "css-framework",
    "semantic",
    "semantic-ui",
    "bulma",
    "material",
    "material-design",
    "materialize",
    "foundation"
  ],
  "homepage": "https://bootstrap-table.com",
  "bugs": {
    "url": "https://github.com/wenzhixin/bootstrap-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenzhixin/bootstrap-table.git"
  },
  "license": "MIT",
  "author": "wenzhixin <wenzhixin2010@gmail.com> (http://wenzhixin.net.cn/)",
  "type": "module",
  "main": "dist/bootstrap-table.min.js",
  "types": "./index.d.ts",
  "style": "dist/bootstrap-table.min.css",
  "directories": {
    "doc": "site"
  },
  "files": [
    "dist/",
    "src/",
    "!src/.babelrc",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "bower.json",
    "bootstrap-table.jquery.json",
    "composer.json",
    "index.d.ts",
    "package.json"
  ],
  "scripts": {
    "format": "prettier --cache --write .",
    "lint:js": "eslint src tests cypress",
    "lint:css": "stylelint src/**/*.scss",
    "lint:spell": "cspell lint --no-progress src/**/*.{js,json,vue,scss} site/**/*.md *.md",
    "lint:editor": "editorconfig-checker -exclude dist",
    "lint": "run-s lint:*",
    "test:cypress": "cypress run --headless",
    "test:vitest": "vitest run",
    "test": "run-s test:*",
    "docs:check:api": "cd tools && node check-api.js",
    "docs:check:locale": "cd tools && node check-locale.js",
    "docs:check": "run-s docs:check:*",
    "js:build:base": "rollup -c",
    "js:build:min": "cross-env NODE_ENV=production rollup -c",
    "js:build:vue": "vite build",
    "js:build": "run-s js:build:*",
    "css:build:src": "sass --no-source-map -I node_modules src:src",
    "css:build:base": "sass --no-source-map -I node_modules src:dist",
    "css:build:min": "cleancss -O1 --format breakWith=lf --with-rebase --batch --batch-suffix .min \"dist/**/*.css\" \"!dist/**/*.min.css\"",
    "css:build": "run-s css:build:*",
    "banner": "headify \"dist/**/*.{min.css,js}\"",
    "clean": "rimraf dist",
    "build": "run-s lint clean *:build banner",
    "pre-commit": "run-s lint docs:check"
  },
  "resolutions": {
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "immutable": "5.1.8",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "qs": "6.15.3",
    "shell-quote": "1.9.0",
    "systeminformation": "5.31.17",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "chalk": "^6.0.1",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.0",
    "cypress": "^16.2.1",
    "editorconfig-checker": "^7.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "headify": "^0.1.1",
    "jquery": "^4.0.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-packagejson": "^3.0.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.66.0",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.106.1",
    "shelljs": "^0.10.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "jquery": "3 || 4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.18.0 || >=26.3.0",
      "onFail": "error"
    }
  },
  "sass": "src/bootstrap-table.scss"
}
